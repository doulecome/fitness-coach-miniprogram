.header {
  padding: 40rpx 32rpx 16rpx;
}
.title {
  font-size: 44rpx;
  font-weight: 800;
}
.subtitle {
  font-size: 26rpx;
  color: var(--sub);
  margin-top: 8rpx;
}

.filter {
  display: flex;
  padding: 16rpx 32rpx 8rpx;
  flex-wrap: wrap;
}
.chip {
  font-size: 26rpx;
  color: #5a6066;
  background: #fff;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  margin: 0 16rpx 16rpx 0;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.03);
}
.chip-on {
  background: var(--accent);
  color: #fff;
  font-weight: 600;
}

.list {
  padding: 16rpx 32rpx;
}
.plan {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
}
.plan-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  font-size: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.plan-info {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
}
.plan-name {
  font-size: 32rpx;
  font-weight: 700;
}
.plan-desc {
  font-size: 24rpx;
  color: var(--sub);
  margin: 8rpx 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.plan-meta {
  font-size: 24rpx;
  color: #6b7178;
}
.tag {
  color: #fff;
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  margin-right: 10rpx;
}
.plan-btn {
  flex-shrink: 0;
  margin-left: 16rpx;
  background: var(--accent);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 16rpx 36rpx;
  border-radius: 999rpx;
}

/* 分段切换 */
.segment {
  display: flex;
  margin: 8rpx 32rpx 0;
  background: #eef0f2;
  border-radius: 999rpx;
  padding: 6rpx;
}
.seg {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #6b7178;
  padding: 16rpx 0;
  border-radius: 999rpx;
  font-weight: 600;
}
.seg-on {
  background: #fff;
  color: var(--accent);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

/* 动作库 */
.groups {
  padding: 24rpx 32rpx 8rpx;
}
.group {
  margin-bottom: 24rpx;
}
.group-title {
  font-size: 30rpx;
  font-weight: 700;
  margin: 16rpx 4rpx;
  position: relative;
  padding-left: 20rpx;
}
.group-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 6rpx;
  width: 8rpx;
  height: 30rpx;
  background: var(--accent);
  border-radius: 4rpx;
}
.action-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.action-card {
  width: 31.5%;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 0;
  text-align: center;
  margin-bottom: 16rpx;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.04);
}
.action-emoji {
  font-size: 52rpx;
}
.action-name {
  font-size: 26rpx;
  margin-top: 10rpx;
  font-weight: 600;
}
.action-val {
  font-size: 22rpx;
  color: var(--sub);
  margin-top: 4rpx;
}

/* 动作详情弹层 */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}
.sheet {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 40rpx 56rpx;
  box-sizing: border-box;
}
.sheet-icon {
  font-size: 80rpx;
  text-align: center;
}
.sheet-name {
  text-align: center;
  font-size: 40rpx;
  font-weight: 800;
  margin-top: 12rpx;
}
.sheet-row {
  display: flex;
  justify-content: space-between;
  padding: 24rpx 8rpx;
  border-bottom: 1rpx solid #f2f3f5;
  font-size: 28rpx;
}
.sheet-k {
  color: var(--sub);
}
.sheet-v {
  font-weight: 600;
}
.sheet-cue {
  margin-top: 20rpx;
  background: #f0f7ff;
  color: #3a6ea5;
  font-size: 26rpx;
  line-height: 1.6;
  padding: 22rpx 24rpx;
  border-radius: 16rpx;
}
.sheet-tip {
  margin-top: 24rpx;
  background: #f3fbf8;
  color: #16B892;
  font-size: 26rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  line-height: 1.6;
}
.sheet-btns {
  display: flex;
  margin-top: 32rpx;
}
.sheet-btn {
  flex: 1;
  height: 92rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  background: var(--accent);
  color: #fff;
  margin: 0 10rpx;
}
.sheet-btn.ghost {
  background: #eef0f2;
  color: #5a6066;
}
.sheet-btn.demo-btn {
  background: #fff;
  color: var(--accent);
  border: 2rpx solid var(--accent);
}
