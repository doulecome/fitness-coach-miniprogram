.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 32rpx 60rpx;
}

.header {
  padding: 40rpx 0 24rpx;
}
.h-title {
  font-size: 44rpx;
  font-weight: 800;
}
.h-sub {
  font-size: 26rpx;
  color: var(--sub);
  margin-top: 10rpx;
  line-height: 1.5;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
}
.form {
  padding: 12rpx 32rpx 28rpx;
  margin-top: 12rpx;
}
.field {
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}
.field:last-child {
  border-bottom: none;
}
.f-label {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}
.opts {
  display: flex;
  flex-wrap: wrap;
}
.opt {
  font-size: 26rpx;
  color: #5a6066;
  background: #f3f4f6;
  padding: 16rpx 32rpx;
  border-radius: 999rpx;
  margin: 0 16rpx 16rpx 0;
}
.opt.on {
  background: var(--accent);
  color: #fff;
  font-weight: 700;
}

/* 休息日选择 */
.f-hint {
  font-size: 22rpx;
  font-weight: 400;
  color: #9aa0a6;
  margin-left: 8rpx;
}
.f-clear {
  font-size: 22rpx;
  color: #14B085;
  float: right;
  font-weight: 600;
}
.week-opts {
  margin-top: 4rpx;
}
.wchip {
  font-size: 26rpx;
  color: #5a6066;
  background: #f3f4f6;
  padding: 14rpx 0;
  width: 13%;
  text-align: center;
  border-radius: 14rpx;
  margin: 0 1% 12rpx 0;
}
.wchip.on {
  background: var(--accent);
  color: #fff;
  font-weight: 700;
}

.gen-btn {
  margin-top: 40rpx;
  background: linear-gradient(135deg, #1FD6A8, #14B085);
  color: #fff;
  text-align: center;
  font-size: 34rpx;
  font-weight: 800;
  padding: 32rpx;
  border-radius: 999rpx;
  box-shadow: 0 12rpx 28rpx rgba(31, 214, 168, 0.3);
}

/* 结果态 */
.summary {
  display: flex;
  padding: 36rpx 0;
  margin-top: 8rpx;
}
.sm {
  flex: 1;
  text-align: center;
}
.sm-num {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--accent);
}
.sm-lab {
  font-size: 24rpx;
  color: var(--sub);
  margin-top: 6rpx;
}
.level-note {
  font-size: 24rpx;
  color: #16B892;
  background: #f3fbf8;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  margin: 24rpx 0;
  line-height: 1.5;
}

.week {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.day {
  width: 31.5%;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 0;
  text-align: center;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.04);
  border: 2rpx solid transparent;
}
.day.rest {
  background: #f7f8fa;
  color: var(--sub);
}
.day-icon {
  font-size: 48rpx;
}
.day-wd {
  font-size: 24rpx;
  color: var(--sub);
  margin-bottom: 8rpx;
}
.day-name {
  font-size: 26rpx;
  font-weight: 600;
  margin-top: 6rpx;
}
.day-meta {
  font-size: 22rpx;
  color: var(--sub);
  margin-top: 4rpx;
}
.day-rest {
  font-size: 26rpx;
  margin-top: 30rpx;
}

.today-bar {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #1FD6A8, #14B085);
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-top: 8rpx;
  color: #fff;
}
.today-bar.rest {
  background: #f3f4f6;
  color: var(--text);
}
.tb-info {
  flex: 1;
}
.tb-label {
  font-size: 24rpx;
  opacity: 0.9;
}
.tb-name {
  font-size: 32rpx;
  font-weight: 700;
  margin-top: 6rpx;
}
.tb-btn {
  background: #fff;
  color: #14B085;
  font-weight: 800;
  font-size: 30rpx;
  padding: 16rpx 48rpx;
  border-radius: 999rpx;
}

.regen {
  text-align: center;
  color: #9aa0a6;
  font-size: 28rpx;
  margin-top: 36rpx;
}

/* 4 周周期切换 */
.phase-tabs {
  display: flex;
  margin: 4rpx 0 20rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 10rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
}
.pt {
  flex: 1;
  text-align: center;
  border-radius: 16rpx;
  padding: 16rpx 0 14rpx;
  color: var(--sub);
}
.pt.on {
  background: linear-gradient(135deg, #1FD6A8, #14B085);
  color: #fff;
}
.pt-i {
  font-size: 22rpx;
  font-weight: 600;
}
.pt-l {
  font-size: 20rpx;
  opacity: 0.9;
  margin-top: 4rpx;
}
.phase-tip {
  font-size: 24rpx;
  color: #8a5a00;
  background: #fff8e6;
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  margin: 0 0 20rpx;
  line-height: 1.5;
}
.level-note.cycle {
  color: #5a6066;
  background: #f5f6f8;
}
.level-note.fit {
  color: #0e7d5f;
  background: #e6f7f1;
  font-weight: 600;
}

/* 周视图卡片增强：位置 + 定制角标 + 快捷开练 */
.day {
  position: relative;
  padding-bottom: 20rpx;
}
.day.rest {
  padding-bottom: 24rpx;
}
.day-custom {
  font-size: 18rpx;
  color: #0e9f76;
  background: #e6f7f1;
  border-radius: 999rpx;
  display: inline-block;
  padding: 4rpx 12rpx;
  margin-top: 10rpx;
  font-weight: 600;
}
.day-go {
  position: absolute;
  right: 10rpx;
  bottom: 10rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #fff;
  background: var(--accent);
  border-radius: 999rpx;
  padding: 8rpx 18rpx;
  line-height: 1.2;
}
.day.rest .day-meta {
  display: none;
}

/* 处方弹层 */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}
.sheet {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 36rpx 48rpx;
  box-sizing: border-box;
  max-height: 82vh;
  display: flex;
  flex-direction: column;
}
.sh-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.sh-title {
  font-size: 34rpx;
  font-weight: 800;
}
.sh-close {
  font-size: 32rpx;
  color: #b5bac0;
  padding: 8rpx 16rpx;
}
.sh-sub {
  font-size: 24rpx;
  color: var(--sub);
  margin-top: 10rpx;
}
.sh-legacy {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #b07a00;
  background: #fff8e6;
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
  line-height: 1.5;
}
.sh-list {
  margin: 24rpx 0 12rpx;
  max-height: 42vh;
  flex: 1;
}
.sh-row {
  display: flex;
  align-items: center;
  padding: 16rpx 4rpx;
  border-bottom: 1rpx solid #f3f4f6;
}
.sh-ic {
  width: 60rpx;
  text-align: center;
  font-size: 34rpx;
  margin-right: 8rpx;
}
.sh-mid {
  flex: 1;
  min-width: 0;
}
.sh-name {
  font-size: 28rpx;
  font-weight: 600;
}
.sh-last {
  font-size: 22rpx;
  color: #b5bac0;
  margin-top: 4rpx;
}
.sh-goal {
  text-align: right;
  margin-left: 16rpx;
}
.sh-num {
  font-size: 36rpx;
  font-weight: 800;
  color: #5a6066;
  font-variant-numeric: tabular-nums;
}
.sh-num.fit {
  color: var(--accent);
}
.sh-unit {
  font-size: 22rpx;
  color: var(--sub);
  margin-left: 4rpx;
}
.sh-tip {
  font-size: 22rpx;
  color: #9aa0a6;
  text-align: center;
  margin: 8rpx 0 20rpx;
}
.sh-btn {
  background: linear-gradient(135deg, #1FD6A8, #14B085);
  color: #fff;
  text-align: center;
  font-size: 32rpx;
  font-weight: 800;
  padding: 26rpx;
  border-radius: 999rpx;
  box-shadow: 0 12rpx 28rpx rgba(31, 214, 168, 0.3);
}

/* —— v4 动态训练计划：教练总述 / 训练日卡片 / 当日训练弹层 —— */
.coach-intro {
  font-size: 26rpx;
  color: #5a6066;
  background: #eef7ff;
  border-radius: 16rpx;
  padding: 22rpx 26rpx;
  margin: 0 0 20rpx;
  line-height: 1.65;
}
.pt-d {
  display: inline-block;
  font-size: 18rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 999rpx;
  padding: 2rpx 12rpx;
  margin-top: 6rpx;
}
.pt:not(.on) .pt-d {
  background: #eef0f2;
  color: #9aa0a6;
}
.day-name {
  line-height: 1.3;
  padding: 0 8rpx;
}
.day-meta2 {
  font-size: 22rpx;
  color: var(--sub);
  margin-top: 2rpx;
}
/* 弹层：热身 / 教练按语 / 动作组行 */
.sh-warm {
  font-size: 24rpx;
  color: #a05a00;
  background: #fff6e8;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  line-height: 1.55;
  margin-bottom: 14rpx;
}
.sh-coach {
  font-size: 24rpx;
  color: #0e7d5f;
  background: #eef9f5;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  line-height: 1.55;
  margin-bottom: 18rpx;
}
.sh-group {
  display: flex;
  align-items: center;
  padding: 18rpx 4rpx;
  border-bottom: 1rpx solid #f3f4f6;
}
.sh-group:last-child {
  border-bottom: none;
}
.sh-name {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}
.sh-tag {
  font-size: 18rpx;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin-left: 10rpx;
  font-weight: 600;
  line-height: 1.4;
}
.tag-主项 {
  color: #8a2be2;
  background: #f6efff;
}
.tag-收尾 {
  color: #0e7d5f;
  background: #e6f7f1;
}
.tag-冷身 {
  color: #2b6bb0;
  background: #eaf2fc;
}
.sh-round {
  font-size: 20rpx;
  color: #fff;
  background: #5a6066;
  border-radius: 999rpx;
  padding: 3rpx 14rpx;
  margin-left: 10rpx;
  font-weight: 700;
}
