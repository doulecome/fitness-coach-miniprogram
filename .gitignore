# 微信开发者工具私有配置（含个人 appid / 编译缓存）
project.private.config.json

# 项目本地工作数据（记忆日志 / 自动化脚本数据，不上传）
.workbuddy/

# 浏览器预览生成物（可由 scripts/gen_demo_preview.js / gen_plan_preview.js 重新生成）
preview/

# ExerciseDB 素材库抓取快照/缓存（大文件，可由脚本重新抓取）
scripts/exdb_full.json
scripts/exdb_cache.json

# exercises-dataset 原始数据集（17MB 源，build_zh.js 可经 jsDelivr 重新拉取；同 ExerciseDB 同源）
scripts/dset/

# 已弃用路线（开练 Kailian 抓取管线，改接 exercises-dataset 后不再使用）
scripts/dump_actions.js
scripts/kailian_capture.py
scripts/actions.json
scripts/__pycache__/

# 临时与日志
*.log
*.tmp
